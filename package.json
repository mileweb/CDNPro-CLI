{
  "name": "cdnpro-cli",
  "version": "2.0.0",
  "description": "CDN Pro CLI — human and AI-agent friendly interface to the CDN Pro API",
  "bin": {
    "cdnpro": "./dist/cli/main.js"
  },
  "main": "./dist/client/CDNProClient.js",
  "types": "./dist/client/CDNProClient.d.ts",
  "files": [
    "dist",
    "!dist/test",
    "openapi.json"
  ],
  "scripts": {
    "build": "npm run generate:types && npm run clean && tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli/main.js', 0o755)\"",
    "fetch:spec": "node scripts/fetch-openapi.js",
    "spec:check": "node scripts/fetch-openapi.js --check",
    "spec:update": "node scripts/spec-update.js",
    "spec:diff": "node scripts/spec-diff.js",
    "update:spec": "node scripts/spec-update.js",
    "generate:types": "npm run fetch:spec && openapi-typescript openapi.json -o src/types/api.ts",
    "predev": "npm run fetch:spec",
    "clean": "node scripts/clean.js",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/fetch-openapi.js --check --release",
    "dev": "tsx src/cli/main.ts",
    "pretest": "npm run clean && tsc",
    "test": "node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "conf": "^9.0.0",
    "keytar": "^7.9.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
